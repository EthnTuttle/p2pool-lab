+#[cfg(all(test, feature = "sqlite", feature = "electrum"))]
+mod custom_genesis_tests {
+    use super::*;
+    use crate::config::WalletConfig;
+    use bdk_wallet::bitcoin::BlockHash;
+    use bdk_wallet::rusqlite::Connection;
+    use std::str::FromStr;
+
+    const TESTNET5_GENESIS: &str =
+        "00000000000008c1637e7d3252dc1c333d4546fd6fff6a474b200d674a91d497";
+
+    fn options() -> WalletOpts {
+        let config: WalletConfig = toml::from_str(&format!(
+            r#"
+            [wallets.testnet5]
+            network = "testnet4"
+            genesis_hash = "{TESTNET5_GENESIS}"
+            ext_descriptor = "tr(79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798)"
+            database_type = "sqlite"
+            client_type = "electrum"
+            server_url = "tcp://127.0.0.1:50001"
+            "#
+        ))
+        .unwrap();
+        config.get_wallet_opts("testnet5").unwrap()
+    }
+
+    #[test]
+    fn custom_genesis_survives_reload_and_rejects_wrong_chain() {
+        let mut connection = Connection::open_in_memory().unwrap();
+        let mut opts = options();
+        let expected = BlockHash::from_str(TESTNET5_GENESIS).unwrap();
+        let wallet = new_persisted_wallet(Network::Testnet4, &mut connection, &opts).unwrap();
+        assert_eq!(wallet.local_chain().genesis_hash(), expected);
+        assert!(
+            wallet
+                .peek_address(KeychainKind::External, 0)
+                .to_string()
+                .starts_with("tb1p")
+        );
+        drop(wallet);
+        let reloaded = new_persisted_wallet(Network::Testnet4, &mut connection, &opts).unwrap();
+        assert_eq!(reloaded.local_chain().genesis_hash(), expected);
+        drop(reloaded);
+        opts.genesis_hash = None;
+        assert!(new_persisted_wallet(Network::Testnet4, &mut connection, &opts).is_err());
+    }
+
+    #[test]
+    fn non_persisted_wallet_uses_custom_genesis() {
+        let wallet = new_wallet(Network::Testnet4, &options()).unwrap();
+        assert_eq!(
+            wallet.local_chain().genesis_hash(),
+            BlockHash::from_str(TESTNET5_GENESIS).unwrap()
+        );
+    }
+}
