 #[derive(Parser, Debug, PartialEq, Clone)]
 pub struct BalanceCommand;
 
+#[cfg(test)]
+mod wallet_history_tests {
+    use super::*;
+    use bdk_wallet::Wallet;
+    use bdk_wallet::bitcoin::hashes::Hash;
+    use bdk_wallet::bitcoin::{
+        Amount, Network, OutPoint, ScriptBuf, Transaction, TxIn, TxOut, Txid, absolute, transaction,
+    };
+    use std::path::PathBuf;
+
+    #[test]
+    fn history_reports_wallet_amounts_instead_of_all_transaction_outputs() {
+        let mut wallet = Wallet::create_single(
+            "wpkh(0279be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798)",
+        )
+        .network(Network::Regtest)
+        .create_wallet_no_persist()
+        .unwrap();
+        let owned_script = wallet
+            .reveal_next_address(KeychainKind::External)
+            .script_pubkey();
+        let funding = Transaction {
+            version: transaction::Version::TWO,
+            lock_time: absolute::LockTime::ZERO,
+            input: vec![TxIn {
+                previous_output: OutPoint::new(Txid::from_byte_array([1; 32]), 0),
+                ..Default::default()
+            }],
+            output: vec![
+                TxOut {
+                    value: Amount::from_sat(12_000),
+                    script_pubkey: owned_script,
+                },
+                TxOut {
+                    value: Amount::from_sat(88_000),
+                    script_pubkey: ScriptBuf::new(),
+                },
+            ],
+        };
+        let funding_id = funding.compute_txid();
+        wallet.apply_unconfirmed_txs([(funding, 1)]);
+        let spend = Transaction {
+            version: transaction::Version::TWO,
+            lock_time: absolute::LockTime::ZERO,
+            input: vec![TxIn {
+                previous_output: OutPoint::new(funding_id, 0),
+                ..Default::default()
+            }],
+            output: vec![TxOut {
+                value: Amount::from_sat(8_000),
+                script_pubkey: ScriptBuf::new(),
+            }],
+        };
+        let spend_id = spend.compute_txid();
+        wallet.apply_unconfirmed_txs([(spend, 2)]);
+        let mut context =
+            AppContext::new_offline_wallet(Network::Regtest, PathBuf::new(), &mut wallet);
+        let result = TransactionsCommand.execute(&mut context).unwrap();
+        let received = result
+            .items
+            .iter()
+            .find(|item| item.txid == funding_id.to_string())
+            .unwrap();
+        assert_eq!(received.received, 12_000);
+        assert_eq!(received.sent, 0);
+        let sent = result
+            .items
+            .iter()
+            .find(|item| item.txid == spend_id.to_string())
+            .unwrap();
+        assert_eq!(sent.sent, 12_000);
+        assert_eq!(sent.received, 0);
+        assert_eq!(sent.fee, Some(4_000));
+        assert!(sent.chain_position.get("Unconfirmed").is_some());
+    }
+}
